  "script": {
    "name": "Aksara Bolaang Mongondow",
    "alt_names": [
      "Aksara Bicol Bolaang Mongondow",
      "Basahan (istilah asal Filipina untuk aksara Bicolano)"
    ],
    "type": "abugida (setiap simbol dasar = konsonan + vokal inheren 'a'; diubah dengan diakritik untuk vokal lain, dan tanda silang '+' untuk mematikan vokal / bentuk akhir)",
    "direction": "kiri ke kanan",
    "letter_count": 15,
    "credit": "Bagan disusun ulang oleh @atmabumiangkasa (Instagram) berjudul 'Aksara Bolaang Mongondow' / 'Loloda Mokoagow'.",
    "related_research_community": "Historia Bolaang Mongondow Raya (HistoriaBMR) — mempublikasikan klaim penemuan aksara ini pada artefak 'Boyo-boyo' peninggalan Istana Komalig dan pada fragmen manuskrip berbahasa Spanyol.",
    "academic_status": "BELUM menjadi konsensus akademik arus utama. Klaim penggunaan historis aksara Bicol/Basahan di Bolaang Mongondow berasal dari riset komunitas/sejarah lokal, dan menurut sumber yang sama, klaim ini 'sangat ditentang oleh peneliti lainnya'. Gunakan sebagai materi budaya/edukasi dengan atribusi yang jelas, bukan sebagai fakta akademik final.",
    "structure_notes": [
      "Baris 1: konsonan + vokal inheren 'a' (15 simbol dasar).",
      "Baris 2: satu simbol yang sama dipakai untuk vokal 'e' dan 'i' (dibedakan lewat konteks/tanda kecil di atas simbol, mirip 'kudlit' pada aksara Baybayin/Basahan Filipina).",
      "Baris 3: satu simbol yang sama dipakai untuk vokal 'o' dan 'u'.",
      "Baris 4: bentuk 'mati' (konsonan akhir tanpa vokal), ditandai simbol silang '+' — mirip 'krus-kudlit/pamudpod' yang diperkenalkan misionaris Spanyol pada aksara Filipina untuk mematikan bunyi vokal. Huruf 'h' tidak memiliki bentuk mati pada bagan ini."
    ],
    "sources": [
      "Bagan 'Aksara Bolaang Mongondow' / 'Loloda Mokoagow' oleh @atmabumiangkasa (koleksi pengguna).",
      "Papan tulis latihan transliterasi (koleksi pengguna).",
      "Fragmen naskah bertuliskan campuran Spanyol-aksara mengenai Sultan Baabullah (1557) dan pertemuan besar Loloda Mokoagow (1593) (koleksi pengguna).",
      "https://historybmr.blogspot.com/2017/10/bahasa-mongondow-kuno-induk-bahasa.html (acuan sejarah Bahasa Mongondow, lihat juga knowledge/Bahasa_Mongondow_Kuno_Acuan_Utama.md)"
    ]
  },
